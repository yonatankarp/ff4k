CREATE TABLE FF4K_PROPERTIES (
    name TEXT PRIMARY KEY NOT NULL,
    type TEXT NOT NULL,
    description TEXT,
    read_only INTEGER NOT NULL DEFAULT 0,
    data TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_ff4k_properties_type ON FF4K_PROPERTIES(type);

selectAll:
SELECT * FROM FF4K_PROPERTIES;

selectByName:
SELECT * FROM FF4K_PROPERTIES WHERE name = ?;

exists:
SELECT EXISTS(SELECT 1 FROM FF4K_PROPERTIES WHERE name = ?);

count:
SELECT COUNT(*) FROM FF4K_PROPERTIES;

listNames:
SELECT name FROM FF4K_PROPERTIES;

insert:
INSERT INTO FF4K_PROPERTIES (name, type, description, read_only, data, version)
VALUES (?, ?, ?, ?, ?, 1);

update:
UPDATE FF4K_PROPERTIES
SET type = :type, description = :description, read_only = :read_only, data = :data, version = :expectedVersion + 1
WHERE name = :name AND version = :expectedVersion;

upsert:
INSERT INTO FF4K_PROPERTIES (name, type, description, read_only, data, version)
VALUES (?, ?, ?, ?, ?, 1)
ON CONFLICT (name) DO UPDATE SET
    type = EXCLUDED.type,
    description = EXCLUDED.description,
    read_only = EXCLUDED.read_only,
    data = EXCLUDED.data,
    version = FF4K_PROPERTIES.version + 1;

deleteByName:
DELETE FROM FF4K_PROPERTIES WHERE name = ?;

deleteAll:
DELETE FROM FF4K_PROPERTIES;