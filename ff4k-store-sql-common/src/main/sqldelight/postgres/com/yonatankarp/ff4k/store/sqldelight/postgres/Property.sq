CREATE TABLE FF4K_PROPERTIES (
    name TEXT PRIMARY KEY NOT NULL,
    type TEXT NOT NULL,
    value TEXT NOT NULL,
    description TEXT,
    read_only INTEGER NOT NULL DEFAULT 0,
    fixed_values TEXT NOT NULL DEFAULT '[]'
);

selectAll:
SELECT * FROM FF4K_PROPERTIES;

selectByName:
SELECT * FROM FF4K_PROPERTIES WHERE name = ?;

exists:
SELECT EXISTS(SELECT 1 FROM FF4K_PROPERTIES WHERE name = ?);

count:
SELECT COUNT(*) FROM FF4K_PROPERTIES;

listNames:
SELECT name FROM FF4K_PROPERTIES;

insert:
INSERT INTO FF4K_PROPERTIES (name, type, value, description, read_only, fixed_values)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE FF4K_PROPERTIES
SET type = ?, value = ?, description = ?, read_only = ?, fixed_values = ?
WHERE name = ?;

upsert:
INSERT INTO FF4K_PROPERTIES (name, type, value, description, read_only, fixed_values)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT (name) DO UPDATE SET
    type = EXCLUDED.type,
    value = EXCLUDED.value,
    description = EXCLUDED.description,
    read_only = EXCLUDED.read_only,
    fixed_values = EXCLUDED.fixed_values;

deleteByName:
DELETE FROM FF4K_PROPERTIES WHERE name = ?;

deleteAll:
DELETE FROM FF4K_PROPERTIES;