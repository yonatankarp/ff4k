CREATE TABLE properties (
    name TEXT PRIMARY KEY NOT NULL,
    type TEXT NOT NULL,
    value TEXT NOT NULL,
    description TEXT,
    read_only INTEGER NOT NULL DEFAULT 0,
    fixed_values TEXT NOT NULL DEFAULT '[]'
);

selectAll:
SELECT * FROM properties;

selectByName:
SELECT * FROM properties WHERE name = ?;

exists:
SELECT EXISTS(SELECT 1 FROM properties WHERE name = ?);

count:
SELECT COUNT(*) FROM properties;

listNames:
SELECT name FROM properties;

insert:
INSERT INTO properties (name, type, value, description, read_only, fixed_values)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE properties
SET type = ?, value = ?, description = ?, read_only = ?, fixed_values = ?
WHERE name = ?;

upsert:
INSERT OR REPLACE INTO properties (name, type, value, description, read_only, fixed_values)
VALUES (?, ?, ?, ?, ?, ?);

deleteByName:
DELETE FROM properties WHERE name = ?;

deleteAll:
DELETE FROM properties;