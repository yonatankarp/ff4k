CREATE TABLE features (
    id TEXT PRIMARY KEY NOT NULL,
    data TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT * FROM features;

selectById:
SELECT * FROM features WHERE id = ?;

upsert:
INSERT INTO features (id, data, version)
VALUES (?, ?, 1)
ON CONFLICT(id) DO UPDATE SET data = excluded.data, version = version + 1;

updateIfVersion:
UPDATE features SET data = :data, version = :expectedVersion + 1
WHERE id = :id AND version = :expectedVersion AND data = :expectedData;

deleteById:
DELETE FROM features WHERE id = ?;

changes:
SELECT changes();
